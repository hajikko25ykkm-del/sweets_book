<div class="container">
  <div class="row vh-100 align-items-center justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card book-page shadow-sm p-4">
        <h2 class="text-center mb-4">新規登録</h2>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <div class="mb-4">
            <%= f.label :名前, class: "form-label fw-bold" %><br />
            <%= f.text_field :name, autofocus: true, class: "form-control custom-input" %>
          </div>
          <div class="mb-4">
            <%= f.label :メールアドレス, class: "form-label fw-bold" %><br />
            <%= f.email_field :email, autocomplete: "email", class: "form-control custom-input" %>
          </div>
          <div class="mb-4">
            <%= f.label :パスワード, class: "form-label fw-bold" %>
            <% if @minimum_password_length %>
            <em>(<%= @minimum_password_length %> characters minimum)</em>
            <% end %><br />
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control custom-input" %>
          </div>
          <div class="mb-4">
            <%= f.label :パスワード確認, class: "form-label fw-bold" %><br />
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control custom-input" %>
          </div>
          <div class="d-grid mt-4">
            <%= f.submit "新規登録", class: "btn btn-dark shadow-sm" %>
          </div>
        <% end %>
        
        <div class="text-center mt-4">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>