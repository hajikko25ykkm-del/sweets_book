<div class="container">
  <div class="row vh-100 align-items-center justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card book-page shadow-sm p-4">
        <h2 class="text-center mb-4">ログイン</h2>

        <div class="error-container">
          <% if flash[:alert] %>
            <div class="alert alert-danger p-2 small mb-4">
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-4">
            <%= f.label :メールアドレス, class: "form-label fw-bold" %><br />
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control custom-input" %>
          </div>
          <div class="mb-4">
            <%= f.label :パスワード, class: "form-label fw-bold" %><br />
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control custom-input" %>
          </div>
          <% if devise_mapping.rememberable? %>
            <div class="mb-4">
              <%= f.check_box :remember_me %>
              <%= f.label :保存 %>
            </div>
          <% end %>
          <div class="d-grid mt-4">
            <%= f.submit "ログイン", class: "btn btn-dark shadow-sm" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>