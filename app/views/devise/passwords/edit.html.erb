<div class="container">
  <div class="row vh-100 aligin-items-center justify-content-center">
    <div class="col-md-5 col-lg-4">
      <h2 class="text-center mb-4">パスワード変更</h2>
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-4">
          <%= f.label :password, "新しいパスワード", class: "form-label fw-bold" %><br />
          <% if @minimum_password_length %>
            <em>(<%= @minimum_password_length %> 文字以上)</em><br />
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-label custom-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "新しいパスワード確認", class: "form-label fw-bold" %><br />
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control custom-input" %>
        </div>

        <div class="d-grid mb-4">
          <%= f.submit "パスワードを変更する", class: "btn btn-light shadow-sm border" %>
        </div>
      <% end %>

      <div class="text-center mt-4">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>