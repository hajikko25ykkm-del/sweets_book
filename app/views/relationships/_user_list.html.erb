<div class="user-item">

  <div class="user-name">
    <%= link_to user.name, user_path(user)%>
    <% if user.privacy %>
      <span class="privacy-icon">🔒</span>
    <% end %>
    <span class="post-count">
      投稿: <%= user.posts.count %>件
    </span>
  </div>

  <div class="user-action">
    <%= render "relationships/btn", user: user %>
  </div>

</div>

<p><%= link_to '一覧に戻る', posts_path %></p>