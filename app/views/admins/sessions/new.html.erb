<div class="container">
  <div class="row vh-100 align-items-center justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card shadow border-0 p-4">
        <h2 class="text-center mb-4 fw-bold text-secondary">管理者ログイン</h2>

        <div class="error-container">
          <% if flash[:alert] %>
            <div class="alert alert-danger p-2 small mb-4">
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-4">
            <%= f.label :メールアドレス, class: "form-label" %><br />
            <%= f.email_field :email, autofocus: true, class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :パスワード, class: "form-label" %><br />
            <%= f.password_field :password, class: "form-control" %>
          </div>

          <div class="d-grid mt-4">
            <%= f.submit "ログイン", class: "btn btn-primary shadow-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
