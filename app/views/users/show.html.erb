<div class="user-profile container mt-5">
  <div class="profile-layout">
    
    <div class="profile-main">
      <h1 class="profile-name">
        <i class="fa-solid fa-circle-user"></i> <%= @user.name %>
      </h1>
      
      <div class="profile-stats">
        <span class="stat-item">
          フォロー <%= link_to @user.followings.count, user_followings_path(@user) %>
        </span>
        <span class="stat-item">
          フォロワー <%= link_to @user.followers.count, user_followers_path(@user) %>
        </span>
      </div>

      <% if @user == current_user %>
        <div class="favorite-link-area">
          <%= link_to favorite_posts_path, class: "btn-favorite-list" do %>
            <i class="fa-solid fa-bookmark"></i> お気に入り一覧
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="profile-action">
      <% if @user == current_user %>
        <%= link_to "プロフィール編集", edit_user_path(@user), class: "btn-edit-profile" %>
      <% else %>
        <%= render "relationships/btn", user: @user %>
      <% end %>
    </div>

  </div>
</div>

<hr class="profile-divider">

<section class="user-posts post-index container">
  <h2 class="index-title"><i class="fa-solid fa-utensils"></i> 投稿したレシピ</h2>

  <% if @user != current_user && @user.privacy %>
    
    <div class="private-account-lock text-center">
      <p class="lock-title">このアカウントの投稿は非公開です</p>
      <p class="lock-text">ユーザーの設定により、すべての投稿が非表示になっています。</p>
    </div>

  <% else %>
    <div class="post-grid">
      <% if @posts.any? %>
        <% @posts.each do |post| %>
          <%= render 'posts/post_card', post: post %>
        <% end %>
      <% else %>
        <div class="empty-state">
          <p class="empty-text">まだ投稿したレシピはありません。</p>
          <% if @user == current_user %>
            <%= link_to "レシピを投稿する", new_post_path, class: "btn-post-link" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>