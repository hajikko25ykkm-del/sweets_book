<!DOCTYPE html>
<html>
  <head>
    <title>SweetsBook</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="<%= 'admin-mode' if admin_signed_in? %>">
      <h1><%= link_to "SweetsBook", root_path %></h1>
      <nav>
        <div class="nav-content"> 
          <% if admin_signed_in? %>
            <ul class="nav-links">
              <li><%= link_to "ダッシュボード", admin_root_path %></li>
              <li><%= link_to "ユーザー管理", admin_users_path %></li>
              <li><%= link_to "投稿管理", admin_posts_path %></li>
              <li><%= link_to "ログアウト", destroy_admin_session_path, method: :delete %></li>
            </ul>
          <% elsif user_signed_in? %>
            <ul class="nav-links"> <li><%= link_to "投稿一覧", posts_path %></li>
              <li><%= link_to "マイページ", user_path(current_user.id) %></li>
              <li><%= link_to "投稿フォーム", new_post_path %></li>
              <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete %></li>
            </ul>
            <div class="search-container">
              <%= form_with url: search_path, method: :get, local: true do |f| %>
                <%= f.text_field :word, placeholder: "検索ワードを入力" %>
                <%= f.select :range, options_for_select([["ユーザー", "User"], ["投稿", "Post"]]) %>
                <%= f.submit "検索" %>
              <% end %>
            </div>
          <% else %>
            <ul class="nav-links">
              <li><%= link_to "About", about_path %></li>
              <li><%= link_to "新規登録", new_user_registration_path %></li>
              <li><%= link_to "ログイン", new_user_session_path %></li>
            </ul>
          <% end %>
        </div>
      </nav>
    </header>

    <main>
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>
    </main>

    <%= yield %>
  </body>
</html>
