<div class="top-background">
  <div class="book-container">
    <div class="book-open">
      <div class="book-left">
        <div class="book-image-wrapper">
          <%= image_tag 'macarons.jpg', class: "hero-image" %>
        </div>
      </div>

      <div class="book-right">
        <div class="hero-section">
          <h1>Sweets Book</h1>
          <p class="sub-title">「秘密のレシピ」と「こだわり」が繋がる場所</p>
        </div>

        <section class="community-intro">
          <h2>お菓子作りの「コツ」を、みんなで共有</h2>
          <p>
            一人で悩むお菓子作りは、もう終わり<br>
            あなたのレシピが、誰かの最高の一皿に変わります
          </p>
        </section>

        <section class="top-cta">
          <div class="cta-content">
            <h5 class="mb-3">一緒にお菓子作ってみませんか？</h5>
            <div class="cta-actions">
              <% if user_signed_in? %>
                <p class="mt-5">
                  <%= link_to "新しいレシピを書く", new_post_path %>
                </p>
              <% else %>
                <p class="mt-5">
                  <%= link_to "ゲストログイン（閲覧用）", users_guest_sign_in_path, method: :post %>
                </p>
                <%= link_to "新規登録", new_user_registration_path %> |
                <%= link_to "ログイン", new_user_session_path %>
              <% end %>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>
</div>
