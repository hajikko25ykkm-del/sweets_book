<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="card shadow-sm p-4">

        <%= form_with(model: @post, local: true) do |f| %>
          <% if @post.errors.any? %>
            <div id="error_explanation" class="alert alert-danger">
              <h2 class="h6"><%= @post.errors.count %>件のエラーがあります</h2>
              <ul class="mb-0 small">
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-4">
            <%= f.label :image, "メイン写真", class: "form-label fw-bold" %>
            <%= f.file_field :image, class: "form-control" %>
          </div>

          <div class="row mb-4">
            <div class="col-md-8">
              <%= f.label :title, "レシピ名", class: "form-label fw-bold" %>
              <%= f.text_field :title, class: "form-control", placeholder: "米粉のクッキー！" %>
            </div>
            <div class="col-md-4">
              <%= f.label :genre_id, "ジャンル", class: "form-label fw-bold" %>
              <%= f.collection_select :genre_id, Genre.all, :id, :name, { prompt: "選択してください" }, { class: "form-select" } %>
            </div>

          </div>

          <div class="mb-4">
            <%= f.label :body, "説明", class: "form-label fw-bold" %>
            <%= f.text_area :body, class: "form-control", rows: 3, placeholder: "このレシピのポイントは..." %>
          </div>

          <hr class="my-4">

          <div id="ingredient-container" class="mb-3">
            <h3 class="h5 mb-3">材料</h3>
            <%= f.fields_for :post_ingredients do |pi_form| %>
              <div class="ingredient-field row g-2 mb-2">
                <div class="col-7">
                  <%= pi_form.text_field :ingredient_name, class: "form-control form-control-sm", placeholder: "材料名" %>
                </div>
                <div class="col-5">
                  <%= pi_form.text_field :quantity, class: "form-control form-control-sm", placeholder: "分量" %>
                </div>
              </div>
            <% end %>
          </div>
          <button type="button" id="add-ingredient" class="btn btn-outline-secondary btn-sm mb-4">＋ 材料を追加</button>

          <div id="step-container" class="mb-3">
            <h3 class="h5 mb-3">作り方</h3>
            <%= f.fields_for :steps do |s| %>
              <div class="step-field card bg-light p-3 mb-3">
                <div class="d-flex align-items-center mb-2">
                  <span class="badge bg-dark me-2">1</span>
                  <%= s.file_field :image, class: "form-control form-control-sm" %>
                </div>
                <%= s.text_area :content, class: "form-control", rows: 2, placeholder: "手順を入力" %>
                <%= s.hidden_field :position, value: 1, class: "step-position" %>
              </div>
            <% end %>
          </div>
          <button type="button" id="add-step" class="btn btn-outline-secondary btn-sm mb-4">＋ 工程を追加</button>

          <div class="publish-setting card p-3 mb-4">
            <h3 class="h6 mb-3">公開設定</h3>
            <div class="d-flex gap-4 justify-content-center">
              <div class="form-check">
                <%= f.radio_button :is_public, true, class: "form-check-input", checked: true %>
                <%= f.label :is_public_true, "全員に公開", class: "form-check-label mr-3" %>
              </div>
              <div class="form-check">
                <%= f.radio_button :is_public, false, class: "form-check-input" %>
                <%= f.label :is_public_false, "自分のみ（非公開）", class: "form-check-label" %>
              </div>
            </div>
            <p class="text-muted small text-center mt-3 mb-0">
              ※非公開にすると、マイページ以外からは見られなくなります。
            </p>
          </div>

          <div class="d-grid gap-2 mt-5">
            <%= f.submit "レシピを投稿する", class: "btn btn-primary btn-lg" %>
            <%= link_to "キャンセル", posts_path, class: "btn btn-link text-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

