<div class="post-card-container">
  <div class="post-card">

    <%= link_to post_path(post), class: "post-image-link" do %>
      <div class="post-image">
        <% if post.image.attached? %>
          <%= image_tag post.image %>
        <% end %>
      </div>
    <% end %>

    <div class="post-info">
      <h3 class="post-title">
        <div id="favorite-btn-<%= post.id %>" class="favorite-button-area">
          <%= render 'favorites/btn', post: post %>
        </div>

        <%= link_to post.title, post_path(post), class: "post-title-link" %>
      </h3>
      
      <p class="post-user"><span>投稿者: </span> <%= post.user.name %></p>
      <div class="post-date">投稿日: <%= post.created_at.strftime('%Y/%m/%d') %></div>
      
      <div class="post-tag">
        <span class="badge"># <%= post.genre.name %></span>
      </div>
    </div>

  </div>
</div>