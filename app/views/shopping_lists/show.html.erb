<section class="shopping-list-section py-5">
  <div class="container">
    <h2 class="mb-4">買い物リスト</h2>

    <div class="card mb-4 shadow-sm">
      <div class="card-body">
        <h5 class="card-title">メモ</h5>
        <%= form_with model: @shopping_list, url: shopping_list_path, method: :patch, local: true do |f| %>
          <%= f.text_area :content, class: "form-control", rows: 3, placeholder: "ラッピング包材など..." %>
          <div class="text-end mt-2">
            <%= f.submit "メモを保存", class: "btn btn-sm btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @items_by_post.any? %>
      <% @items_by_post.each do |post, items| %>
        <div class="card mb-3 border-primary shadow-sm">
          <div class="card-header bg-primary text-white">
            <strong><%= post.title %></strong>
          </div>
          <ul class="list-group list-group-flush">
            <% items.each do |item| %>
              <li id="shopping-item-mult-<%= item.id %>" class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <%= link_to destroy_item_shopping_list_path(item), method: :delete, remote: true, class: "form-check-input-link" do %>
                    <input type="checkbox" class="form-check-input me-2">
                  <% end %>
                  <span><%= item.post_ingredient&.ingredient_name %></span>
                </div>
                <%= link_to "削除", destroy_item_shopping_list_path(item), method: :delete, remote: true, class: "text-danger small" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5 border rounded bg-light">
        <p class="text-muted mb-0">リストに材料はありません。レシピ詳細から追加しましょう！</p>
      </div>
    <% end %>

    <div class="mt-4">
      <%= link_to "投稿一覧へ戻る", posts_path, class: "btn btn-secondary w-100" %>
    </div>
  </div>
</section>