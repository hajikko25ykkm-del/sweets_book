<section class="py-5 bg-light" style="min-height: 100vh;">
  <div class="container">
    <h2 class="text-center mb-5" style="color: #8d6e63;">📔 買い物リスト</h2>

    <hr>

    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="memo-notebook">
          <h5 class="fw-bold mb-3">メモ</h5>
          <%= form_with model: @shopping_list, url: shopping_list_path, method: :patch, local: true do |f| %>
            <%= f.text_area :content, class: "form-control border-0 bg-transparent", rows: 10, placeholder: "ラッピングや保冷剤など..." %>
            <div class="text-end mt-3">
              <%= f.submit "ノートに保存", class: "btn btn-sm btn-dark" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="col-md-8">
        <% if @items_by_post.any? %>
          <div class="row">
            <% @items_by_post.each do |post, items| %>
              <div class="col-sm-6">
                <div class="sticky-note">
                  <div class="sticky-note-title">
                    <%= link_to post.title, post_path(post), class: "text-decoration-none text-dark" %>
                  </div>
                  <ul class="list-unstyled mb-0">
                    <% items.each do |item| %>
                      <li class="mb-2 d-flex align-items-center">
                        <%= check_box_tag "item_#{item.id}", 1, item.is_bought, 
                              class: "form-check-input me-2",
                              data: { url: update_item_status_shopping_list_path(item), method: :patch, remote: true } %>
                        <span class="small"><%= item.post_ingredient&.ingredient_name %></span>
                        <small class="text-muted ms-1">(<%= item.post_ingredient&.quantity %>)</small>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-5">
            <p class="text-muted">付箋はまだありません。レシピから追加しましょう！</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>