<section class="post-index">
  <h2 class="index-title">
    "<%= @word %>" の検索結果 (<%= @range == 'User' ? 'ユーザー' : '投稿' %>)
  </h2>
  <hr>

  <% if @range == "User" %>
    <table class="table">
      <thead>
        <tr>
          <th>名前</th>
          <th>詳細リンク</th>
        </tr>
      </thead>
      <tbody>
        <% @results.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= link_to "プロフィールへ", user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% elsif @range == "Post" %>
      <div class="posts-container">
        <% @results.each do |post| %>
          <%= link_to post_path(post), class: "post-card-link" do %>
            <div class="post-card">
              <div class="post-image">
                <% if post.image.attached? %>
                  <%= image_tag post.image %>
                <% end %>
              </div>
              <div class="post-info">
                <h3 class="post-title"><%= post.title %></h3>
                <p class="post-user"><span>投稿者: </span> <%= post.user.name %></p>
                <div class="post-date">投稿日: <%= post.created_at.strftime('%Y/%m/%d') %></div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p>検索対象を選択してください。</p>
    <% end %>

</section>