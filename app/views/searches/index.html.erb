<section class="post-index">
  <h2 class="index-title">
    "<%= @word %>" の検索結果 (<%= @range == 'User' ? 'ユーザー' : '投稿' %>)
  </h2>

  <hr>

  <% if @range == "User" %>
    <table class="table">
      <thead>
        <tr>
          <th>名前</th>
          <th>詳細リンク</th>
        </tr>
      </thead>
      <tbody>
        <% @results.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= link_to "プロフィールへ", user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% elsif @range == "Post" %>
      <div class="post-grid">
        <% @results.each do |post| %>
          <%= render 'posts/post_card', post: post %>
        <% end %>
      </div>
    <% else %>
      <p>検索対象を選択してください。</p>
    <% end %>

</section>