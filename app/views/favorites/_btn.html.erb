<div id="favorite_btn_<%= post.id %>">
  <% if user_signed_in? %>
    <% if post.favorited_by?(current_user) %>
      <div class="bookmark-fav active">
        <%= link_to post_favorite_path(post), method: :delete, remote: true do %>
          <span class="fav-count"><%= post.favorites.count %></span>
        <% end %>
      </div>
    <% else %>
      <div class="bookmark-fav">
        <%= link_to post_favorite_path(post), method: :post, remote: true do %>
          <span class="fav-count"><%= post.favorites.count %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>