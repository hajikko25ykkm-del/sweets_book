<section class="admin-user-index">
  <h1 class="admin-title">
    <i class="fa-solid fa-users-gear"></i> ユーザー登録者管理
  </h1>

  <hr class="admin-divider">

  <div class="user-grid">
    <% @users.each do |user| %>
      <div class="user-item-container">
        
        <%= link_to admin_user_path(user), class: "user-card-link" do %>
          <div class="user-card">
            <div class="user-info">
              <h3 class="user-name">
                <%= user.name %> <span class="user-id">(ID: <%= user.id %>)</span>
              </h3>
              
              <div class="user-contact">
                <strong>Email:</strong>
                <p><%= user.email %></p>
              </div>

              <div class="user-date">
                登録日: <%= user.created_at.strftime('%Y/%m/%d') %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="admin-action-area">
          <%= link_to admin_user_path(user), method: :delete, 
                data: { confirm: "#{user.name}さんを退会させますか？" }, 
                class: "btn-admin-withdraw" do %>
            <i class="fa-solid fa-user-slash"></i> ユーザーを退会させる
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>