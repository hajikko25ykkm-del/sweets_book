<div class="admin-user-profile">
  <div class="profile-header">
    <h1 class="profile-title">
      <i class="fa-solid fa-address-card"></i> <%= @user.name %> さんの管理詳細
    </h1>
    <div class="header-actions">
      <%= link_to admin_users_path, class: "btn-admin-back" do %>
        <i class="fa-solid fa-chevron-left"></i> ユーザー一覧に戻る
      <% end %>
    </div>
  </div>

  <div class="user-info-card">
    <div class="info-item">
      <span class="info-label">メールアドレス</span>
      <span class="info-value"><%= @user.email %></span>
    </div>
    <div class="info-item">
      <span class="info-label">ステータス</span>
      <span class="info-value">
        <span class="badge-count">フォロー <strong><%= @user.followings.count %></strong></span>
        <span class="badge-count">フォロワー <strong><%= @user.followers.count %></strong></span>
      </span>
    </div>
  </div>
</div>

<hr class="admin-divider">

<section class="admin-post-index">
  <h2 class="index-title"><i class="fa-solid fa-images"></i> このユーザーの投稿一覧</h2>

  <div class="post-grid">
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <div class="post-item-container">
          <div class="post-card">
            <%= link_to admin_post_path(post), class: "post-image-link" do %>
              <div class="post-image">
                <% if post.image.attached? %>
                  <%= image_tag post.image %>
                <% else %>
                  <div class="no-image-placeholder">No Image</div>
                <% end %>
              </div>
            <% end %>

            <div class="post-info">
              <h3 class="post-title"><%= post.title %></h3>
              <div class="post-meta">
                <div class="post-date">
                  <i class="fa-regular fa-calendar"></i> <%= post.created_at.strftime('%Y/%m/%d') %>
                </div>
              </div>
              
              <div class="admin-action-area">
                <%= link_to admin_post_path(post), method: :delete, 
                      data: { confirm: '管理権限でこの投稿を削除しますか？' }, 
                      class: "btn-admin-delete" do %>
                  <i class="fa-solid fa-trash-can"></i> 投稿を削除
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state">
        <p>まだ投稿はありません。</p>
      </div>
    <% end %>
  </div>
</section>