<div class="admin-stats-container">
  <h2 class="stats-title">サイト全体の状況</h2>
  
  <div class="stats-flex">
    <div class="stat-item">
      <%= link_to admin_users_path, class: "stat-link" do %>
        <p class="stat-label">登録者</p>
        <p class="stat-value-wrapper">
          <span class="value-num accent"><%= @user_count || 0 %></span>
          <span class="value-unit">人</span>
        </p>
      <% end %>
    </div>

    <div class="stat-item">
      <p class="stat-label">投稿総数</p>
      <p class="stat-value-wrapper">
        <span class="value-num"><%= @post_count || 0 %></span>
        <span class="value-unit">件</span>
      </p>
    </div>
  </div>
</div>

<hr>

<section class="post-index">
  <h2 class="index-title">最新の投稿（5件）</h2>
  <hr>

  <div class="post-grid">
    <% @posts.each do |post| %>
      <div class="post-item-container">
        <%= link_to post_path(post), class: "post-card-link" do %>
          <div class="post-card">
            <div class="post-image">
              <%= image_tag post.image if post.image.attached? %>
            </div>
            <div class="post-info">
              <h3 class="post-title"><%= post.title %></h3>
              <p class="post-user"><span>投稿者: </span> <%= post.user.name %></p>
              <div class="post-date">投稿日: <%= post.created_at.strftime('%Y/%m/%d') %></div>
            </div>
          </div>
        <% end %>

        <div class="admin-btn-area">
          <%= link_to "管理権限で削除", admin_post_path(post), method: :delete, 
              data: { confirm: '本当にこの投稿を削除しますか？（管理者の操作です）' }, 
              class: "btn-delete-admin" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-end mt-3">
    <%= link_to "すべての投稿を管理する ≫", admin_posts_path, class: "view-all-link" %>
  </div>
</section>