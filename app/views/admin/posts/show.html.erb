<div class="admin-post-inspection">
  <h1>投稿詳細（管理者モード）</h1>
  <div class="admin-actions-top">
    <%= link_to '投稿管理一覧に戻る', admin_posts_path, class: "btn-admin-back" %>
    <%= link_to 'この投稿を丸ごと削除', admin_post_path(@post),
        method: :delete, data: { confirm: '本当にこの投稿を削除しますか？' },
        class: "btn-admin-destroy" %>
  </div>
</div>

<div class="recipe-detail-container container py-4">

  <div class="recipe-main-header">
    <div class="recipe-image">
      <%= image_tag @post.image if @post.image.attached? %>
    </div>
    
    <div class="recipe-info">
      <div class="recipe-title-wrapper">
        <h1 class="recipe-title"><%= @post.title %></h1>
      </div>
  
      <div class="recipe-comment">
        <p><span class="label">ひとこと:</span> <%= simple_format(@post.body) %></p>
      </div>

      <div class="recipe-meta">
        <p class="recipe-user">投稿者: <%= link_to @post.user.name, admin_user_path(@post.user) %> さん</p>
        <p class="recipe-date">
          投稿日: <%= @post.created_at.strftime('%Y/%m/%d %H:%M') %>
        </p>
      </div>
    </div>
  </div>

  <hr class="recipe-divider">

  <div class="row mt-4">

    <div class="col-md-4 mb-4">
      <div class="loose-leaf">
        <div class="loose-leaf-header">
          <h3 class="mb-0">材料</h3>
        </div>
        <div class="loose-leaf-body">
          <table class="table table-borderless align-middle mb-0">
            <tbody>
              <% @post.post_ingredients.each do |pi| %>
                <% if pi.ingredient.present? || pi.quantity.present? %>
                  <tr class="note-line">
                    <td class="text-center" style="width: 45px;">
                      <%= check_box_tag "shopping_#{pi.id}", 1, pi.is_shopping_list, disabled: true %>
                    </td>
                    <td><%= pi.ingredient&.name || "材料名不明" %></td>
                    <td class="text-end text-muted small pe-3"><%= pi.quantity %></td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <h3 class="section-title mb-4">作り方</h3>
      <div class="steps-list">
        <% @post.steps.each.with_index(1) do |step, index| %>
          <% if step.content.present? %>
            <div class="step-card mb-4">
              <div class="row g-0 align-items-center">
                <div class="col-sm-7 p-3">
                  <div class="d-flex align-items-start">
                    <span class="step-number-text fw-bold me-2">Step<%= index %></span>
                    <div class="step-text mb-0"><%= simple_format(step.content) %></div>
                  </div>
                </div>
                <div class="col-sm-5 p-2">
                  <% if step.image.attached? %>
                    <div class="step-image-box">
                      <%= image_tag step.image.variant(resize_to_limit: [400, 400]), class: "img-fluid rounded" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <hr class="recipe-divider my-5">
      <div class="comment-section-admin">
        <h3 class="mb-4">コメント管理</h3>
        
        <div id="comments-list">
          <% if @post.comments.any? %>
            <% @post.comments.each do |comment| %>
              <div class="admin-comment-item border rounded p-3 mb-3 bg-white shadow-sm" id="admin-comment-<%= comment.id %>">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="comment-user-info">
                    <span class="fw-bold text-dark"><%= comment.user.name %></span>
                    <span class="text-muted small ms-2"><%= comment.created_at.strftime('%Y/%m/%d %H:%M') %></span>
                  </div>
                  
                  <div class="admin-comment-delete">
                    <%= link_to '削除', admin_post_comment_path(@post, comment), 
                        method: :delete, 
                        remote: :true,
                        data: { confirm: '管理者の権限でこのコメントを削除しますか？' }, 
                        class: "btn-admin-destroy-sm" %>
                  </div>
                </div>
                
                <div class="comment-content mt-2 border-top pt-2">
                  <%= simple_format(comment.body) %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="alert alert-light border">コメントはまだありません。</div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>